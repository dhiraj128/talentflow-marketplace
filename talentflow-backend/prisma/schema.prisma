generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String?
  role              Role               @default(CANDIDATE)
  isEmailVerified   Boolean            @default(false)
  phoneVerified     Boolean            @default(false)
  phoneNumber       String?            @unique
  countryCode       String?
  verificationMethod VerificationMethod? @default(EMAIL)
  refreshToken      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  avatarUrl         String?
  githubId          String?            @unique
  googleId          String?            @unique
  provider          String?
  status            UserStatus         @default(ACTIVE)
  auditLogs         AuditLog[]         @relation("ActionBy")
  candidateProfile  CandidateProfile?
  identityDocuments IdentityVerificationDocument[]
  employerProfile   EmployerProfile?
  freelancerProfile FreelancerProfile?
  sentMessages      Message[]
  notifications     Notification[]
  subscriptions Subscription[]
  trainerProfile    TrainerProfile?
  statusHistory     ApplicationStatusHistory[]
  interviewFeedback InterviewFeedback[] @relation("EmployerUserFeedback")
  savedSearches     SavedSearch[]
  searchHistories   SearchHistory[]
}

model EmployerProfile {
  id             String           @id @default(uuid())
  userId         String           @unique
  companyName    String
  industry       String?
  logoUrl        String?
  subscription   SubscriptionTier @default(FREE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  bio            String?
  location       String?
  phone          String?
  websiteUrl     String?
  billing        Billing[]
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs           Job[]
  projectRequests ProjectRequest[]
  reviews Review[]
  interviews     Interview[]
  notes          EmployerCandidateNote[]
  candidateTags  CandidateTag[]
  savedCandidates SavedCandidate[]
  talentPools    TalentPool[]
  sentInvitations CandidateInvitation[]
  offers         JobOffer[]
}

model CandidateProfile {
  id                  String           @id @default(uuid())
  userId              String           @unique
  fullName            String
  title               String?
  location            String?
  avatarUrl           String?
  resumeUrl           String?
  profileDiscoverable Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  bio                 String?
  education           Json?
  experience          Json?
  githubUrl           String?
  linkedinUrl         String?
  phone               String?
  portfolioUrl        String?
  applications        Application[]
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills              CandidateSkill[]
  certificates        Certificate[]
  coverLetters        CoverLetter[]
  enrollments         Enrollment[]
  resumes             Resume[]
  interviews          Interview[]
  savedByEmployers    SavedCandidate[]
  talentPoolMemberships TalentPoolMember[]
  receivedInvitations CandidateInvitation[]
  savedJobs           SavedJob[]
  candidateTagAssignments CandidateTagAssignment[]
  offers              JobOffer[]
  jobAlerts           JobAlert[]
}

model TrainerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  fullName  String
  bio       String?
  expertise String?
  avatarUrl String?
  rating    Float?   @default(0.0)
  isVerified Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courses   Course[]
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FreelancerProfile {
  id              String            @id @default(uuid())
  userId          String            @unique
  fullName        String
  title           String?
  bio             String?
  hourlyRate      Float?
  portfolioUrl    String?
  githubUrl       String?
  avatarUrl       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  availability    String?
  isVerified      Boolean           @default(false)
  location        String?
  rating          Float             @default(0.0)
  reviewCount     Int               @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills FreelancerSkill[]
  projectRequests ProjectRequest[]
  reviews Review[]
}

model Job {
  id             String          @id @default(uuid())
  employerId     String
  title          String
  location       String?
  type           String?
  salaryRange    String?
  description    String
  status         JobStatus       @default(DRAFT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  applications   Application[]
  employer       EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  requiredSkills JobSkill[]
  invitations    CandidateInvitation[]
  savedByCandidates SavedJob[]
  offers         JobOffer[]
  alertDeliveries JobAlertDelivery[]
}

model Application {
  id            String                     @id @default(uuid())
  candidateId   String
  jobId         String
  resumeId      String?
  status        ApplicationStatus          @default(PENDING)
  matchScore    Int                        @default(0)
  appliedAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  candidate     CandidateProfile           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job           Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume        Resume?                    @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  interviews    Interview[]
  statusHistory ApplicationStatusHistory[]
  notes         EmployerCandidateNote[]
  tags          ApplicationTagAssignment[]
  offers        JobOffer[]

  @@unique([candidateId, jobId])
}

model Skill {
  id              String            @id @default(uuid())
  name            String            @unique
  category        String?
  createdAt       DateTime          @default(now())
  candidates      CandidateSkill[]
  skills FreelancerSkill[]
  jobs            JobSkill[]
}

model CandidateSkill {
  candidateId String
  skillId     String
  proficiency Int?
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([candidateId, skillId])
}

model JobSkill {
  jobId       String
  skillId     String
  isMandatory Boolean @default(true)
  job         Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
}

model Course {
  id           String         @id @default(uuid())
  title        String
  category     String
  description  String
  thumbnailUrl String?
  rating       Float?         @default(0.0)
  studentCount Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  trainerId    String
  duration     String?
  level        String?
  price        Float          @default(0.0)
  status       CourseStatus   @default(DRAFT)
  assessment Assessment?
  certificates Certificate[]
  trainer      TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  modules CourseModule[]
  enrollments  Enrollment[]
}

model Enrollment {
  id                String              @id @default(uuid())
  candidateId       String
  courseId          String
  progress          Int                 @default(0)
  enrolledAt        DateTime            @default(now())
  completedAt       DateTime?
  assessmentAttempts AssessmentAttempt[]
  candidate         CandidateProfile    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonProgress LessonProgress[]

  @@unique([candidateId, courseId])
}

model Certificate {
  id             String           @id @default(uuid())
  candidateId    String
  courseId       String
  issuedAt       DateTime         @default(now())
  certificateUrl String?
  candidate      CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([candidateId, courseId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id                     String              @id @default(uuid())
  participant1Id         String
  participant2Id         String
  applicationId          String?
  jobId                  String?
  candidateInvitationId  String?
  interviewId            String?
  offerId                String?
  isArchivedParticipant1 Boolean             @default(false)
  isArchivedParticipant2 Boolean             @default(false)
  lastReadParticipant1   DateTime?
  lastReadParticipant2   DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  messages               Message[]

  @@index([participant1Id])
  @@index([participant2Id])
  @@index([updatedAt])
}

model Message {
  id             String              @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean             @default(false)
  createdAt      DateTime            @default(now())
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments    MessageAttachment[]

  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id         String   @id @default(uuid())
  messageId  String
  storageKey String
  fileName   String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actionBy  String
  action    String
  resource  String
  details   Json?
  createdAt DateTime @default(now())
  user User @relation("ActionBy", fields: [actionBy], references: [id], onDelete: Cascade)
}

model Billing {
  id         String          @id @default(uuid())
  employerId String
  invoiceId  String          @unique
  amount     Float
  status     String
  issuedAt   DateTime        @default(now())
  employer   EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
}

model Resume {
  id          String           @id @default(uuid())
  title       String?
  type        String           @default("ORIGINAL") // ORIGINAL or ATS
  fileName    String?
  storageKey  String?
  bucket      String?
  mimeType    String?
  size        Int?
  version     Int              @default(1)
  createdAt   DateTime         @default(now())
  candidateId String
  content     Json?
  fileUrl     String?
  isDefault   Boolean          @default(false)
  updatedAt   DateTime         @updatedAt
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applications Application[]
}

model ResumeTemplate {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
}

model ResumeOrder {
  id        String   @id @default(uuid())
  status    String
  createdAt DateTime @default(now())
}

model ATSResult {
  id        String   @id @default(uuid())
  score     Int
  createdAt DateTime @default(now())
}

model ResumeReview {
  id        String   @id @default(uuid())
  feedback  String
  createdAt DateTime @default(now())
}

model ResumePayment {
  id        String   @id @default(uuid())
  amount    Float
  createdAt DateTime @default(now())
}

model ResumeWriter {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
}

model CoverLetter {
  id          String           @id @default(uuid())
  content     String
  createdAt   DateTime         @default(now())
  candidateId String
  title       String?
  updatedAt   DateTime         @updatedAt
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model ResumeVerification {
  id        String   @id @default(uuid())
  status    String
  createdAt DateTime @default(now())
}

model EmployerResumeView {
  id       String   @id @default(uuid())
  viewedAt DateTime @default(now())
}

model IdentityVerificationDocument {
  id           String   @id @default(uuid())
  userId       String
  documentUrl  String
  documentType String   @default("Identity")
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assessment {
  id                String              @id
  courseId          String              @unique
  title             String
  passingScore      Int                 @default(70)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assessmentAttempts AssessmentAttempt[]
  questions Question[]
}

model AssessmentAttempt {
  id           String     @id @default(uuid())
  enrollmentId String
  assessmentId String
  score        Int
  passed       Boolean
  attemptedAt  DateTime   @default(now())
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model Category {
  id          String   @id
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id            String    @id
  code          String    @unique
  discountType  String
  discountValue Float
  maxUses       Int?
  usedCount     Int       @default(0)
  expiryDate    DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt DateTime @updatedAt
}

model CourseModule {
  id          String   @id
  courseId    String
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
}

model Designation {
  id          String   @id
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FreelancerSkill {
  freelancerId      String
  skillId           String
  proficiency       Int?
  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([freelancerId, skillId])
}

model Lesson {
  id             String           @id
  moduleId       String
  title          String
  content        String?
  videoUrl       String?
  duration       Int?
  order          Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt DateTime @updatedAt
  module CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonProgress LessonProgress[]
}

model LessonProgress {
  enrollmentId String
  lessonId     String
  isCompleted  Boolean    @default(false)
  completedAt  DateTime?
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([enrollmentId, lessonId])
}

model Location {
  id        String   @id
  name      String   @unique
  country   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Offer {
  id          String    @id
  title       String
  description String?
  discount    Float
  bannerUrl   String?
  isActive    Boolean   @default(true)
  validUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt DateTime @updatedAt
}

model Plan {
  id           String         @id
  name         String         @unique
  description  String?
  price        Float
  billingCycle String         @default("MONTHLY")
  features     Json
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt DateTime @updatedAt
  subscriptions Subscription[]
}

model ProjectRequest {
  id                String               @id @default(uuid())
  employerId        String
  freelancerId      String
  title             String
  description       String
  budget            Float
  status            ProjectRequestStatus @default(PENDING)
  createdAt         DateTime             @default(now())
  updatedAt DateTime @updatedAt
  employer EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  reviews Review[]
}

model Question {
  id           String     @id
  assessmentId String
  text         String
  options      Json
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model Review {
  id                String            @id @default(uuid())
  employerId        String
  freelancerId      String
  projectRequestId  String
  rating            Int
  text              String?
  createdAt         DateTime          @default(now())
  employer EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  ProjectRequest    ProjectRequest    @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)

  @@unique([employerId, projectRequestId])
}

model Subscription {
  id        String   @id
  userId    String
  planId    String
  status    String   @default("ACTIVE")
  startDate DateTime @default(now())
  endDate   DateTime
  autoRenew Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plan Plan @relation(fields: [planId], references: [id])
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  EMPLOYER
  CANDIDATE
  FREELANCER
  TRAINER
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  PENDING
  APPLIED
  REVIEWING
  SHORTLISTED
  INTERVIEWING
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

enum CourseStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

enum ProjectRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum InterviewType {
  PHONE
  VIDEO
  IN_PERSON
  TECHNICAL
  HR
  FINAL
}

model Interview {
  id              String          @id @default(uuid())
  applicationId   String
  employerId      String
  candidateId     String
  type            InterviewType   @default(VIDEO)
  scheduledAt     DateTime
  duration        Int             @default(60)
  timezone        String          @default("UTC")
  meetingProvider String?
  meetingUrl      String?
  location        String?
  instructions    String?
  notes           String?
  feedback        String?
  createdByUserId String?
  status          InterviewStatus @default(SCHEDULED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  employer        EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  candidate       CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  feedbackList    InterviewFeedback[]
}

enum InterviewRecommendation {
  STRONG_HIRE
  HIRE
  NEUTRAL
  NO_HIRE
  STRONG_NO_HIRE
}

model InterviewFeedback {
  id              String                  @id @default(uuid())
  interviewId     String
  employerUserId  String
  rating          Int                     @default(3)
  recommendation  InterviewRecommendation @default(NEUTRAL)
  strengths       String?
  concerns        String?
  notes           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  interview       Interview               @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  employerUser    User                    @relation("EmployerUserFeedback", fields: [employerUserId], references: [id], onDelete: Cascade)
}

enum OfferStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

model JobOffer {
  id             String           @id @default(uuid())
  applicationId  String
  employerId     String
  candidateId    String
  jobId          String
  status         OfferStatus      @default(DRAFT)
  title          String
  salaryAmount   Float
  salaryCurrency String           @default("USD")
  salaryPeriod   String           @default("YEARLY")
  joiningDate    DateTime
  employmentType String?
  workLocation   String?
  message        String?
  declineReason  String?
  expiresAt      DateTime?
  sentAt         DateTime?
  viewedAt       DateTime?
  acceptedAt     DateTime?
  declinedAt     DateTime?
  withdrawnAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  application    Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  employer       EmployerProfile  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  candidate      CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job            Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

enum VerificationMethod {
  EMAIL
  PHONE
  GOOGLE
  GITHUB
}

enum OtpPurpose {
  REGISTER
  LOGIN
  FORGOT_PASSWORD
  CHANGE_EMAIL
  CHANGE_PHONE
}

model OTP {
  id          String     @id @default(uuid())
  identifier  String
  codeHash    String
  purpose     OtpPurpose
  expiresAt   DateTime
  attempts    Int        @default(0)
  createdAt   DateTime   @default(now())
  verifiedAt  DateTime?

  @@index([identifier])
  @@index([expiresAt])
}

model ApplicationStatusHistory {
  id              String            @id @default(uuid())
  applicationId   String
  fromStatus      ApplicationStatus
  toStatus        ApplicationStatus
  changedByUserId String
  changedByRole   String
  reason          String?
  createdAt       DateTime          @default(now())

  application     Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [changedByUserId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model EmployerCandidateNote {
  id            String          @id @default(uuid())
  applicationId String
  employerId    String
  content       String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  employer      EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model CandidateTag {
  id                   String                   @id @default(uuid())
  employerId           String
  name                 String
  color                String?                  @default("blue")
  createdAt            DateTime                 @default(now())

  employer             EmployerProfile          @relation(fields: [employerId], references: [id], onDelete: Cascade)
  assignments          ApplicationTagAssignment[]
  candidateAssignments CandidateTagAssignment[]

  @@unique([employerId, name])
}

model ApplicationTagAssignment {
  applicationId String
  tagId         String
  assignedAt    DateTime    @default(now())

  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tag           CandidateTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([applicationId, tagId])
}

enum InvitationStatus {
  PENDING
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model SavedCandidate {
  id          String           @id @default(uuid())
  employerId  String
  candidateId String
  isFavorite  Boolean          @default(false)
  createdAt   DateTime         @default(now())

  employer    EmployerProfile  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([employerId, candidateId])
  @@index([employerId])
}

model TalentPool {
  id          String             @id @default(uuid())
  employerId  String
  name        String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  employer    EmployerProfile    @relation(fields: [employerId], references: [id], onDelete: Cascade)
  members     TalentPoolMember[]

  @@index([employerId])
}

model TalentPoolMember {
  id            String           @id @default(uuid())
  talentPoolId  String
  candidateId   String
  addedAt       DateTime         @default(now())

  talentPool    TalentPool       @relation(fields: [talentPoolId], references: [id], onDelete: Cascade)
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([talentPoolId, candidateId])
  @@index([talentPoolId])
}

model CandidateInvitation {
  id            String           @id @default(uuid())
  employerId    String
  candidateId   String
  jobId         String
  status        InvitationStatus @default(PENDING)
  message       String?
  expiresAt     DateTime?
  applicationId String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  employer      EmployerProfile  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job           Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([employerId, candidateId])
  @@index([candidateId])
  @@index([jobId])
}

model CandidateTagAssignment {
  candidateId String
  tagId       String
  assignedAt  DateTime     @default(now())

  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  tag         CandidateTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([candidateId, tagId])
}

model SavedJob {
  id          String           @id @default(uuid())
  candidateId String
  jobId       String
  createdAt   DateTime         @default(now())

  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
  @@index([candidateId])
}

enum SearchType {
  JOB
  TALENT
  FREELANCER
  COURSE
}

enum AlertFrequency {
  DAILY
  WEEKLY
}

model SavedSearch {
  id         String     @id @default(uuid())
  userId     String
  name       String
  searchType SearchType @default(JOB)
  queryJson  Json
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobAlerts  JobAlert[]

  @@index([userId, searchType])
}

model JobAlert {
  id            String             @id @default(uuid())
  candidateId   String
  savedSearchId String?
  name          String
  queryJson     Json
  frequency     AlertFrequency     @default(DAILY)
  isActive      Boolean            @default(true)
  lastRunAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  candidate     CandidateProfile   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  savedSearch   SavedSearch?       @relation(fields: [savedSearchId], references: [id], onDelete: SetNull)
  deliveries    JobAlertDelivery[]

  @@index([candidateId, isActive])
}

model JobAlertDelivery {
  id          String   @id @default(uuid())
  jobAlertId  String
  jobId       String
  deliveredAt DateTime @default(now())

  jobAlert    JobAlert @relation(fields: [jobAlertId], references: [id], onDelete: Cascade)
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobAlertId, jobId])
  @@index([jobAlertId])
}

model SearchHistory {
  id         String     @id @default(uuid())
  userId     String
  searchType SearchType @default(JOB)
  queryJson  Json
  createdAt  DateTime   @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SearchEvent {
  id              String     @id @default(uuid())
  userId          String?
  searchType      SearchType @default(JOB)
  normalizedQuery String
  resultCount     Int
  createdAt       DateTime   @default(now())

  @@index([searchType, createdAt])
  @@index([normalizedQuery])
}




